<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ entry.name }} — CUBE Registry</title>
  <meta name="description" content="{{ entry.description_short }}" />
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
  <style>
    .copy-btn { cursor: pointer; }
    .copy-btn:active { transform: scale(0.97); }
    .feature-pill { display: inline-flex; align-items: center; gap: 4px; }
    #yaml-code.hljs { background: transparent; padding: 0; }
  </style>
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen">

<!-- ── Header ────────────────────────────────────────────────────────────── -->
<header class="bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm">
  <div class="max-w-4xl mx-auto px-4 py-3 flex items-center gap-4">
    <a href="../" class="text-indigo-700 font-bold text-lg hover:text-indigo-900 flex items-center gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      CUBE Registry
    </a>
    <span class="text-gray-300">/</span>
    <span class="text-gray-700 font-medium">{{ entry.name }}</span>

    <!-- Status badge -->
    <span class="ml-auto inline-flex items-center text-xs font-medium px-2.5 py-1 rounded-full {{ entry.status_badge.bg }} {{ entry.status_badge.text }}">
      {{ entry.status_badge.label }}
    </span>
  </div>
</header>

<main class="max-w-4xl mx-auto px-4 py-8 space-y-8">

  <!-- ── Title section ──────────────────────────────────────────────────── -->
  <section>
    <div class="flex items-start gap-4 flex-wrap">
      <div class="flex-1 min-w-0">
        <h1 class="text-3xl font-extrabold text-gray-900">{{ entry.name }}</h1>
        <p class="text-sm text-gray-400 mt-1 font-mono">{{ entry.id }} · v{{ entry.version }}</p>
      </div>
      {% if entry.paper %}
      <a href="{{ entry.paper }}" target="_blank" rel="noopener"
         class="flex-shrink-0 text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-lg font-medium">
        📄 Paper
      </a>
      {% endif %}
      {% if entry.getting_started_url %}
      <a href="{{ entry.getting_started_url }}" target="_blank" rel="noopener"
         class="flex-shrink-0 text-sm bg-indigo-50 hover:bg-indigo-100 text-indigo-700 px-3 py-1.5 rounded-lg font-medium">
        📖 Getting Started
      </a>
      {% endif %}
    </div>

    <!-- Tags -->
    {% if entry.tag_chips %}
    <div class="flex flex-wrap gap-2 mt-3">
      {% for chip in entry.tag_chips %}
      <span class="text-sm px-2.5 py-0.5 rounded-full font-medium {{ chip.cls }}">{{ chip.label }}</span>
      {% endfor %}
    </div>
    {% endif %}

    <!-- Description -->
    <p class="mt-4 text-gray-700 leading-relaxed">{{ entry.description }}</p>

    <!-- Authors -->
    {% set authors = entry.get('authors', []) or [] %}
    {% if authors %}
    <p class="mt-3 text-sm text-gray-500">
      By:
      {% for author in authors %}
        <a href="https://github.com/{{ author.github }}" class="text-gray-700 hover:text-indigo-700" target="_blank" rel="noopener">
          @{{ author.github }}{% if author.get('name') %} ({{ author.name }}){% endif %}
        </a>{% if not loop.last %}, {% endif %}
      {% endfor %}
    </p>
    {% endif %}
  </section>

  <!-- ── Install ────────────────────────────────────────────────────────── -->
  <section class="bg-gray-900 rounded-xl p-5">
    <p class="text-gray-400 text-sm mb-2 font-medium uppercase tracking-wider">Install</p>
    <div class="flex items-center gap-3">
      <code id="pip-cmd" class="text-green-400 font-mono text-base flex-1">pip install {{ entry.package }}</code>
      <button
        class="copy-btn bg-gray-700 hover:bg-gray-600 text-gray-200 text-xs px-3 py-1.5 rounded-lg font-medium transition-colors"
        onclick="copyPipInstall()"
        id="copy-btn"
      >Copy</button>
    </div>
    <p class="text-gray-500 text-xs mt-2">
      Version: {{ entry.version }} ·
      <a href="https://pypi.org/project/{{ entry.package }}/{{ entry.version }}/" class="underline hover:text-gray-300" target="_blank" rel="noopener">PyPI page</a>
    </p>
  </section>

  <!-- ── Quick stats ────────────────────────────────────────────────────── -->
  <section class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div class="bg-white rounded-lg border border-gray-200 p-4 text-center">
      <div class="text-2xl font-bold text-indigo-700">
        {% if entry.task_count is not none %}{{ entry.task_count }}{% else %}—{% endif %}
      </div>
      <div class="text-xs text-gray-500 mt-1">Tasks</div>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 p-4 text-center">
      <div class="text-2xl font-bold text-indigo-700">
        {% if entry.get('supported_infra') %}{{ entry.supported_infra | join(', ') }}{% else %}local{% endif %}
      </div>
      <div class="text-xs text-gray-500 mt-1">Infra</div>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 p-4 text-center">
      <div class="text-2xl font-bold {% if entry.has_debug_task %}text-green-600{% else %}text-red-500{% endif %}">
        {% if entry.has_debug_task %}Yes{% else %}No{% endif %}
      </div>
      <div class="text-xs text-gray-500 mt-1">Debug Task</div>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 p-4 text-center">
      <div class="text-2xl font-bold {% if entry.has_debug_agent %}text-green-600{% else %}text-gray-400{% endif %}">
        {% if entry.has_debug_agent %}Yes{% else %}No{% endif %}
      </div>
      <div class="text-xs text-gray-500 mt-1">Debug Agent</div>
    </div>
  </section>

  <!-- ── Feature flags ─────────────────────────────────────────────────── -->
  {% set features = entry.get('features') or {} %}
  {% if features %}
  <section class="bg-white rounded-xl border border-gray-200 p-5">
    <h2 class="text-lg font-bold mb-4">Feature Flags</h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      {% for key, val in features.items() %}
      <div class="flex items-center gap-2 text-sm">
        {% if val %}
        <span class="w-5 h-5 rounded-full bg-green-100 text-green-700 flex items-center justify-center text-xs font-bold flex-shrink-0">✓</span>
        <span class="font-medium text-gray-800">{{ key }}</span>
        {% else %}
        <span class="w-5 h-5 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center text-xs flex-shrink-0">—</span>
        <span class="text-gray-400">{{ key }}</span>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <!-- ── Resources ─────────────────────────────────────────────────────── -->
  {% set resources = entry.get('resources') or [] %}
  {% if resources %}
  <section class="bg-white rounded-xl border border-gray-200 p-5">
    <h2 class="text-lg font-bold mb-4">Resources</h2>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200 text-left text-xs text-gray-500 uppercase tracking-wider">
            <th class="pb-2 pr-4">Type</th>
            <th class="pb-2 pr-4">Name</th>
            <th class="pb-2 pr-4">Image URL</th>
            <th class="pb-2 pr-4">Format</th>
            <th class="pb-2 pr-4">Size</th>
            <th class="pb-2 pr-4">RAM</th>
            <th class="pb-2">GPU</th>
          </tr>
        </thead>
        <tbody>
          {% for res in resources %}
          <tr class="border-b border-gray-100 last:border-0">
            <td class="py-2 pr-4 font-mono text-xs text-purple-700">{{ res.type | default('—') }}</td>
            <td class="py-2 pr-4 font-medium">{{ res.name | default('—') }}</td>
            <td class="py-2 pr-4">
              {% if res.get('image_url') %}
              <a href="{{ res.image_url }}" class="text-indigo-600 hover:underline truncate max-w-xs block text-xs" target="_blank" rel="noopener" title="{{ res.image_url }}">
                {{ res.image_url | truncate(50) }}
              </a>
              {% else %}—{% endif %}
            </td>
            <td class="py-2 pr-4 text-gray-500">{{ res.get('image_format', '—') }}</td>
            <td class="py-2 pr-4 text-gray-500">
              {% if res.get('image_size_gb') %}{{ res.image_size_gb }} GB{% else %}—{% endif %}
            </td>
            <td class="py-2 pr-4 text-gray-500">
              {% if res.get('ram_gb') %}{{ res.ram_gb }} GB{% else %}—{% endif %}
            </td>
            <td class="py-2 text-gray-500">
              {% if res.get('gpu') is not none %}
              {% if res.gpu %}<span class="text-green-600">Yes</span>{% else %}No{% endif %}
              {% else %}—{% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endif %}

  <!-- ── Action space ───────────────────────────────────────────────────── -->
  {% set action_space = entry.get('action_space') or [] %}
  {% if action_space %}
  <section class="bg-white rounded-xl border border-gray-200 p-5">
    <h2 class="text-lg font-bold mb-4">Action Space</h2>
    <div class="space-y-2">
      {% for tool in action_space %}
      <div class="flex gap-3 text-sm">
        <code class="text-purple-700 font-mono bg-purple-50 px-2 py-0.5 rounded text-xs self-start mt-0.5">{{ tool.name | default('?') }}</code>
        <span class="text-gray-600">{{ tool.get('description', '') }}</span>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <!-- ── Legal ─────────────────────────────────────────────────────────── -->
  <section class="bg-white rounded-xl border border-gray-200 p-5">
    <h2 class="text-lg font-bold mb-4">Legal</h2>
    <div class="space-y-3 text-sm">
      <!-- Wrapper license -->
      <div class="flex gap-3 items-start">
        <span class="text-gray-500 w-40 flex-shrink-0">Wrapper license</span>
        <span class="font-mono font-medium text-gray-800">{{ entry.legal.get('wrapper_license', '—') }}</span>
      </div>

      <!-- Benchmark license -->
      {% if entry.bench_license_reported %}
      <div class="flex gap-3 items-start">
        <span class="text-gray-500 w-40 flex-shrink-0">Benchmark license</span>
        <div>
          <span class="font-mono font-medium text-gray-800">{{ entry.bench_license_reported }}</span>
          {% if entry.bench_license_verified %}
          <span class="ml-2 text-xs bg-green-100 text-green-800 px-2 py-0.5 rounded-full font-medium">✓ Confirmed by original authors</span>
          {% else %}
          <span class="ml-2 text-xs bg-yellow-50 text-yellow-700 px-2 py-0.5 rounded-full font-medium border border-yellow-200">Self-reported — verify before commercial use</span>
          {% endif %}
          {% if entry.bench_license_url %}
          <a href="{{ entry.bench_license_url }}" class="ml-2 text-indigo-600 hover:underline text-xs" target="_blank" rel="noopener">Source →</a>
          {% endif %}
        </div>
      </div>
      {% endif %}

      <!-- Notices -->
      {% set notices = entry.legal.get('notices') or [] %}
      {% if notices %}
      <div>
        <p class="text-gray-500 mb-2">Notices</p>
        <div class="space-y-2">
          {% for notice in notices %}
          <div class="bg-orange-50 border border-orange-200 rounded-lg px-3 py-2">
            <span class="text-xs font-medium text-orange-700 font-mono">{{ notice.type | replace('_', ' ') | title }}</span>
            <p class="text-gray-700 text-sm mt-0.5">{{ notice.description }}</p>
            {% if notice.get('url') %}
            <a href="{{ notice.url }}" class="text-indigo-600 hover:underline text-xs" target="_blank" rel="noopener">More info →</a>
            {% endif %}
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </div>

    <div class="mt-4 text-xs text-gray-400 border-t border-gray-100 pt-3">
      License information is self-reported by the cube developer and has not been verified by the AI Alliance.
      Always consult the source URL and original benchmark authors for authoritative terms.
    </div>
  </section>

  <!-- ── Stress results ────────────────────────────────────────────────── -->
  {% if stress_data %}
  <section class="bg-white rounded-xl border border-gray-200 p-5">
    <h2 class="text-lg font-bold mb-1">Stress Test Results</h2>
    <p class="text-xs text-gray-400 mb-4">Generated {{ stress_data.get('generated_at', '—') }} · <a href="../../{{ entry.stress_results_url }}" class="text-indigo-600 hover:underline">Raw JSON</a></p>

    {% for provider, data in stress_data.get('providers', {}).items() %}
    <div class="mb-4">
      <h3 class="font-semibold text-sm text-gray-700 mb-2">Provider: <span class="font-mono">{{ provider }}</span>
        {% if data.passed %}
        <span class="ml-2 text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full">Passed</span>
        {% else %}
        <span class="ml-2 text-xs bg-red-100 text-red-700 px-2 py-0.5 rounded-full">Failed</span>
        {% endif %}
      </h3>
      {% set metrics = data.get('metrics') or {} %}
      {% if metrics %}
      <div class="overflow-x-auto">
        <table class="min-w-full text-xs text-gray-600 border border-gray-100 rounded">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-100">
              <th class="px-3 py-2 text-left">Metric</th>
              <th class="px-3 py-2 text-right">Value</th>
            </tr>
          </thead>
          <tbody>
            {% for k, v in metrics.items() %}
            {% if v is not none %}
            <tr class="border-b border-gray-50 last:border-0">
              <td class="px-3 py-1.5 font-mono text-gray-500">{{ k | replace('_', ' ') }}</td>
              <td class="px-3 py-1.5 text-right font-medium text-gray-800">{{ v }}</td>
            </tr>
            {% endif %}
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% elif data.get('error') %}
      <p class="text-xs text-red-600 bg-red-50 px-3 py-2 rounded">Error: {{ data.error }}</p>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% elif entry.has_stress_results %}
  <section class="bg-white rounded-xl border border-gray-200 p-5">
    <h2 class="text-lg font-bold mb-2">Stress Test Results</h2>
    <a href="../../{{ entry.stress_results_url }}" class="text-indigo-600 hover:underline text-sm">View raw JSON →</a>
  </section>
  {% else %}
  <section class="bg-gray-50 rounded-xl border border-dashed border-gray-300 p-5 text-center text-gray-400 text-sm">
    Slow check not yet run. Stress test results will appear here after the async compliance check completes.
  </section>
  {% endif %}

  <!-- ── Community results journal ─────────────────────────────────────── -->
  <section class="bg-white rounded-xl border border-gray-200 p-5">
    <div class="flex items-baseline justify-between mb-3">
      <h2 class="text-lg font-bold">
        Reproducibility journal
        {% if results_data %}
        <span class="ml-2 text-xs font-normal text-gray-400">{{ results_count }} submission{{ '' if results_count == 1 else 's' }}</span>
        {% endif %}
      </h2>
      <a href="https://github.com/The-AI-Alliance/cube-registry/blob/main/README.md#submitting-a-result"
         class="text-xs text-indigo-600 hover:underline">How to submit →</a>
    </div>

    <!-- Anti-leaderboard callout ─ the framing matters more than the data. -->
    <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs leading-relaxed text-amber-900">
      <p class="font-semibold mb-1">This is a reproducibility journal — not a leaderboard.</p>
      <p class="text-amber-800">
        Submissions document how <em>reference</em> agents and models score over time, across
        infrastructures, cube versions, and package versions. Use it to detect drift and validate
        environments. <strong>Not</strong> a place to publish a new agent or fine-tune to "win" — there is no
        ranking, scores are self-reported, and submissions are unverified. To showcase a new
        agent or model, use ATLAS / EEE / your own benchmark page.
      </p>
    </div>

    {% if results_data %}
    <!-- Grid.js mount point + selection toolbar -->
    <div id="results-grid-toolbar" class="mb-3 flex items-center gap-3 text-xs text-gray-500">
      <span id="results-selected-count">No rows selected</span>
      <button id="results-compare-btn"
              class="hidden rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-indigo-700 disabled:opacity-50"
              disabled>
        Compare selected →
      </button>
      <button id="results-clear-btn"
              class="hidden text-xs text-gray-500 hover:text-gray-700 underline">
        Clear
      </button>
    </div>
    <div id="results-grid"></div>
    <p class="mt-3 text-xs text-gray-400">
      <span class="text-green-700">✓</span> success ·
      <span class="text-red-700">✗</span> failure ·
      <span class="text-yellow-700">⏱</span> max-steps ·
      <span class="text-purple-700">💥</span> system error ·
      <span class="text-gray-500">–</span> missing
      · sort by clicking column headers · check 2+ rows to compare side-by-side
    </p>

    <!-- Embedded result data — read by the Grid.js + compare modal scripts below. -->
    <script id="results-data" type="application/json">{{ results_json | safe }}</script>

    <!-- Compare modal (hidden by default; populated on demand). -->
    <div id="compare-modal" class="fixed inset-0 z-50 hidden bg-gray-900/70 p-4 sm:p-8 overflow-auto">
      <div class="mx-auto max-w-7xl rounded-xl bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-gray-200 px-5 py-3">
          <h3 id="compare-title" class="text-base font-bold">Compare submissions</h3>
          <button id="compare-close" class="text-2xl leading-none text-gray-500 hover:text-gray-800"
                  aria-label="Close">&times;</button>
        </div>
        <div id="compare-body" class="overflow-x-auto p-5 text-xs"></div>
      </div>
    </div>

    <!-- Grid.js (CDN). Vendored CSS keeps the table Tailwind-friendly. -->
    <link href="https://unpkg.com/gridjs/dist/theme/mermaid.min.css" rel="stylesheet" />
    <script src="https://unpkg.com/gridjs/dist/gridjs.umd.js"></script>
    <script>
    (function () {
      const RESULTS = JSON.parse(document.getElementById('results-data').textContent);
      const selected = new Set();

      // ── Selection helpers ──────────────────────────────────────────────
      function toggleSelection(eid, checked) {
        if (checked) selected.add(eid); else selected.delete(eid);
        renderSelectionToolbar();
      }
      function renderSelectionToolbar() {
        const n = selected.size;
        document.getElementById('results-selected-count').textContent =
          n === 0 ? 'No rows selected' :
          n === 1 ? '1 row selected (need 2 or more to compare)' :
                    n + ' rows selected';
        const btn = document.getElementById('results-compare-btn');
        const clr = document.getElementById('results-clear-btn');
        btn.classList.toggle('hidden', n === 0);
        clr.classList.toggle('hidden', n === 0);
        btn.disabled = n < 2;
      }
      document.getElementById('results-compare-btn').addEventListener('click', () => {
        const recs = Array.from(selected).map(getRecord).filter(Boolean);
        if (recs.length >= 2) openCompareModal(recs);
      });
      document.getElementById('results-clear-btn').addEventListener('click', () => {
        selected.clear();
        document.querySelectorAll('.results-checkbox').forEach(cb => { cb.checked = false; });
        renderSelectionToolbar();
      });

      // ── Grid.js table ──────────────────────────────────────────────────
      // Pre-flatten rows for sorting. Numeric score/timestamp give correct sort
      // order; HTML renderers below handle the display.
      const rows = RESULTS.map(r => ({
        eid: r.evaluation_id,
        date: r._date,
        ts: r.evaluation_timestamp,
        agentModel: (r.agent.config_type || '') + ' / ' + (r.agent.llm_model || ''),
        subset: r.benchmark_subset.name + ' · ' + r.benchmark_subset.n_tasks + ' tasks',
        scoreNum: r.results.avg_score,
        scoreDisp: r.results.avg_score.toFixed(3) +
          (r.results.std_err != null ? ' ± ' + r.results.std_err.toFixed(3) : ''),
        outcomes: r.results.outcomes,
        detailUrl: r._detail_url,
      }));

      function outcomesCell(o) {
        return gridjs.html(
          '<span class="text-green-700" title="success">' + o.n_success + '</span>' +
          '<span class="text-gray-300">/</span>' +
          '<span class="text-red-700" title="clean failure">' + o.n_failure + '</span>' +
          '<span class="text-gray-300">/</span>' +
          '<span class="text-yellow-700" title="max steps">' + o.n_max_steps + '</span>' +
          '<span class="text-gray-300">/</span>' +
          '<span class="text-purple-700" title="system error">' + o.n_system_error + '</span>' +
          '<span class="text-gray-300">/</span>' +
          '<span class="text-gray-500" title="missing">' + o.n_missing + '</span>'
        );
      }
      const escapeHtml = (s) => String(s).replace(/[&<>"']/g, c =>
        ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

      new gridjs.Grid({
        columns: [
          {
            id: 'sel', name: '',
            sort: false,
            formatter: (_, row) => {
              const eid = row.cells[1].data; // hidden eid column
              return gridjs.html(
                '<input type="checkbox" class="results-checkbox" data-eid="' +
                escapeHtml(eid) + '" ' + (selected.has(eid) ? 'checked' : '') + '>'
              );
            },
          },
          { id: 'eid', name: '', hidden: true },
          // ISO YYYY-MM-DD dates sort lexically as chronological, so the default
          // string sort is correct here — no custom comparator needed.
          { id: 'date', name: 'Date' },
          { id: 'ts', name: '', hidden: true },
          { id: 'agentModel', name: 'Agent / Model' },
          { id: 'subset', name: 'Subset' },
          { id: 'scoreNum', name: 'Score',
            formatter: (n, row) => row.cells[7].data /* scoreDisp */ },
          { id: 'scoreDisp', name: '', hidden: true },
          { id: 'outcomes', name: 'Outcomes',
            sort: false,
            formatter: (o) => outcomesCell(o) },
          // Detail link opens the same modal as Compare, with N=1 — gives a
          // typed, grouped view of every field instead of dropping the user
          // into the raw JSON. The Raw JSON link remains in the modal column
          // header for anyone who needs the literal file.
          { id: 'eid_detail', name: '',
            sort: false,
            formatter: (eid) => gridjs.html(
              '<button class="results-details text-indigo-600 hover:underline" data-eid="' +
              escapeHtml(eid) + '">Details →</button>') },
        ],
        data: rows.map(r => [
          null, r.eid, r.date, r.ts, r.agentModel, r.subset, r.scoreNum, r.scoreDisp, r.outcomes, r.eid
        ]),
        sort: true,
        pagination: { limit: 20 },
        className: { table: 'text-xs', th: 'bg-gray-50' },
      }).render(document.getElementById('results-grid'));

      // Selection wiring: delegate change events on the grid container so the
      // handler survives Grid.js re-renders during pagination / sorting.
      const grid = document.getElementById('results-grid');
      grid.addEventListener('change', (e) => {
        if (e.target.classList.contains('results-checkbox')) {
          toggleSelection(e.target.dataset.eid, e.target.checked);
        }
      });
      grid.addEventListener('click', (e) => {
        const btn = e.target.closest('.results-details');
        if (!btn) return;
        const rec = getRecord(btn.dataset.eid);
        if (rec) openCompareModal([rec]);
      });

      // ── Compare modal ──────────────────────────────────────────────────
      function getRecord(eid) {
        return RESULTS.find(r => r.evaluation_id === eid);
      }
      // Field plan: [{label, group, getter(record) -> string|null}]
      // null/undefined values render as "—". Diff highlight is applied per row.
      function fieldPlan() {
        return [
          ['Identity', [
            ['Date',                r => r._date],
            ['Evaluation ID',       r => r.evaluation_id],
            ['Submitter',           r => r._submitter],
          ]],
          ['Benchmark', [
            ['Subset name',         r => r.benchmark_subset.name],
            ['Subset n_tasks',      r => String(r.benchmark_subset.n_tasks)],
            ['Subset filter',       r => r.benchmark_subset.filter || null],
            ['Benchmark version',   r => r.benchmark_version],
          ]],
          ['Agent', [
            ['Config type',         r => r.agent.config_type],
            ['LLM model',           r => r.agent.llm_model],
            ['Agent ID (sha-256)',  r => r.agent.agent_id],
            ['Framework version',   r => r.agent.framework_version],
          ]],
          ['Provenance', [
            ['cube-harness commit', r => r.agent.git_commit ? r.agent.git_commit.slice(0,12) : null],
            ['cube-harness dirty?', r => r.agent.git_is_dirty == null ? null : (r.agent.git_is_dirty ? 'yes' : 'no')],
            ['cube-standard commit',r => r.agent.cube_standard_git_commit ? r.agent.cube_standard_git_commit.slice(0,12) : null],
            ['cube-standard dirty?',r => r.agent.cube_standard_git_is_dirty == null ? null : (r.agent.cube_standard_git_is_dirty ? 'yes' : 'no')],
            // 'deps' kind: rendered as a per-package sub-table with amber
            // highlights on rows where the columns disagree. The diff signal
            // matters more than the dump itself.
            {label: 'Dependency versions', kind: 'deps',
              get: r => r.agent.dependency_versions || {}},
          ]],
          ['Outcome', [
            ['Score',               r => r.results.avg_score.toFixed(3)],
            ['Std err',             r => r.results.std_err != null ? r.results.std_err.toFixed(3) : null],
            ['n_success',           r => String(r.results.outcomes.n_success)],
            ['n_failure',           r => String(r.results.outcomes.n_failure)],
            ['n_max_steps',         r => String(r.results.outcomes.n_max_steps)],
            ['n_system_error',      r => String(r.results.outcomes.n_system_error)],
            ['n_missing',           r => String(r.results.outcomes.n_missing)],
            ['Max steps cap',       r => r.results.max_steps_per_episode != null ? String(r.results.max_steps_per_episode) : null],
            ['Avg wall time (s)',   r => r.results.avg_wall_time_s != null ? r.results.avg_wall_time_s.toFixed(1) : null],
            ['Total cost (USD)',    r => r.results.total_cost_usd != null ? '$' + r.results.total_cost_usd.toFixed(2) : null],
          ]],
        ];
      }
      function openCompareModal(recs) {
        if (!recs || recs.length === 0) return;
        document.getElementById('compare-title').textContent =
          recs.length === 1 ? 'Submission details' : 'Compare submissions';
        document.getElementById('compare-body').innerHTML = renderCompareTable(recs);
        document.getElementById('compare-modal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
      function closeCompareModal() {
        document.getElementById('compare-modal').classList.add('hidden');
        document.body.style.overflow = '';
      }
      document.getElementById('compare-close').addEventListener('click', closeCompareModal);
      document.getElementById('compare-modal').addEventListener('click', (e) => {
        if (e.target.id === 'compare-modal') closeCompareModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeCompareModal();
      });

      // Per-package diff renderer for dependency_versions cells. Each input
      // dict gets one column; each row of the inner sub-table is one package.
      // Rows where versions disagree across columns get amber backgrounds —
      // that's the signal that matters when you've selected 2+ runs. The outer
      // cell's amber-or-not mirrors "any package differs".
      function renderDepsCells(dicts, cols) {
        const allKeys = Array.from(new Set(dicts.flatMap(d => Object.keys(d || {})))).sort();
        const totalKeys = allKeys.length;
        if (totalKeys === 0) {
          // Empty deps across all selected columns.
          let html = '';
          for (let i = 0; i < cols; i++) {
            html += '<td class="px-3 py-1.5 border border-gray-100 align-top"><span class="text-gray-400">—</span></td>';
          }
          return html;
        }

        // Which packages differ across columns? For N=1 the answer is always
        // "none" (allEqual short-circuits via cols===1).
        const diffKeys = cols === 1 ? [] : allKeys.filter(k => {
          const first = (dicts[0] || {})[k];
          return dicts.some(d => (d || {})[k] !== first);
        });
        const summarySuffix = cols >= 2
          ? (diffKeys.length === 0 ? ' · all match' : ' · ' + diffKeys.length + ' differ')
          : '';

        // The cell-level amber background: amber if there's any disagreement.
        const cellDiff = diffKeys.length > 0 ? ' bg-amber-50' : '';

        // Each column shows the same summary; the expanded sub-table is per
        // column so the user can read each column's own version list cleanly.
        let html = '';
        for (let c = 0; c < cols; c++) {
          const d = dicts[c] || {};
          // Sub-table rows: one per package, amber when this key is in diffKeys.
          let inner = '<table class="mt-2 w-full border-collapse text-[11px]"><tbody>';
          const diffSet = new Set(diffKeys);
          for (const k of allKeys) {
            const v = d[k];
            const rowDiff = diffSet.has(k) ? 'bg-amber-50' : '';
            const valHtml = v == null
              ? '<span class="text-gray-400">— missing</span>'
              : escapeHtml(v);
            inner += '<tr class="' + rowDiff + '">' +
              '<td class="px-2 py-0.5 text-gray-500 font-mono break-all align-top" style="width:55%">' + escapeHtml(k) + '</td>' +
              '<td class="px-2 py-0.5 text-gray-800 font-mono break-all align-top">' + valHtml + '</td>' +
              '</tr>';
          }
          inner += '</tbody></table>';
          html += '<td class="px-3 py-1.5 border border-gray-100 align-top' + cellDiff + '">' +
            '<details class="cursor-pointer">' +
            '<summary class="text-gray-700">▶ ' + totalKeys + ' items' + summarySuffix + '</summary>' +
            inner +
            '</details>' +
            '</td>';
        }
        return html;
      }

      function renderCompareTable(recs) {
        const plan = fieldPlan();
        const cols = recs.length;
        // table-layout: fixed + a <colgroup> with the Field column pinned at
        // 14rem makes the submission columns share the remaining width
        // equally. Combined with `break-all` on data cells, long
        // monospace strings (sha256 agent_id, git commits, URLs) wrap
        // inside their column instead of forcing horizontal scroll.
        let html = '<table class="w-full border-collapse" style="table-layout:fixed">' +
          '<colgroup><col style="width:14rem">';
        for (let i = 0; i < cols; i++) html += '<col>';
        html += '</colgroup><thead><tr>' +
          '<th class="bg-gray-50 px-3 py-2 text-left font-semibold border border-gray-200">Field</th>';
        for (const r of recs) {
          html += '<th class="px-3 py-2 text-left font-semibold border border-gray-200 bg-gray-50 align-top">' +
            '<div class="font-mono text-gray-700 break-all">' + escapeHtml(r.agent.config_type || '') + ' / ' + escapeHtml(r.agent.llm_model || '') + '</div>' +
            '<div class="text-gray-500 font-normal mt-0.5">' + escapeHtml(r._date) + ' · score ' + r.results.avg_score.toFixed(3) + '</div>' +
            '<div class="mt-1"><a class="text-indigo-600 hover:underline" href="' + escapeHtml(r._detail_url) + '">Raw JSON →</a></div>' +
            '</th>';
        }
        html += '</tr></thead><tbody>';
        for (const [groupName, fields] of plan) {
          html += '<tr><td colspan="' + (cols + 1) + '" class="bg-indigo-50 px-3 py-1.5 font-semibold text-indigo-900 text-[11px] uppercase tracking-wider border border-indigo-100">' + escapeHtml(groupName) + '</td></tr>';
          for (const entry of fields) {
            // Two field-entry shapes:
            //   ['label', getter]                    → kind 'text' (default)
            //   {label, kind: 'deps', get: getter}   → typed renderer
            const label  = Array.isArray(entry) ? entry[0] : entry.label;
            const getter = Array.isArray(entry) ? entry[1] : entry.get;
            const kind   = Array.isArray(entry) ? 'text'   : (entry.kind || 'text');

            const values = recs.map(r => { try { return getter(r); } catch (e) { return null; } });
            html += '<tr>' +
              '<td class="bg-white px-3 py-1.5 text-gray-500 border border-gray-100 align-top">' +
              escapeHtml(label) + '</td>';

            if (kind === 'deps') {
              html += renderDepsCells(values, cols);
            } else {
              // For N=1 there is nothing to diff, so don't highlight cells.
              // For N>=2 a mismatched value lights up amber.
              const allEqual = cols === 1 || values.every(v => v === values[0]);
              for (const v of values) {
                const diffBg = allEqual ? '' : 'bg-amber-50';
                const cellContent = v == null ? '<span class="text-gray-400">—</span>'
                  : '<span class="font-mono text-gray-800 break-all">' + escapeHtml(v) + '</span>';
                html += '<td class="px-3 py-1.5 border border-gray-100 align-top ' + diffBg + '">' + cellContent + '</td>';
              }
            }
            html += '</tr>';
          }
        }
        html += '</tbody></table>';
        if (cols >= 2) {
          html += '<p class="mt-3 text-[11px] text-gray-400">Cells with <span class="bg-amber-50 px-1">amber background</span> differ between selected submissions.</p>';
        }
        return html;
      }
    })();
    </script>

    {% else %}
    <p class="text-sm text-gray-400 text-center py-6">
      No submissions yet. Be the first — see <a href="https://github.com/The-AI-Alliance/cube-registry/blob/main/README.md#submitting-a-result" class="text-indigo-600 hover:underline">how to submit</a>.
    </p>
    {% endif %}
  </section>

  <!-- ── Parallelization info ──────────────────────────────────────────── -->
  {% if entry.get('parallelization_mode') or entry.get('max_concurrent_tasks') %}
  <section class="bg-white rounded-xl border border-gray-200 p-5">
    <h2 class="text-lg font-bold mb-3">Parallelization</h2>
    <div class="flex gap-8 text-sm">
      {% if entry.get('parallelization_mode') %}
      <div>
        <span class="text-gray-500 text-xs uppercase tracking-wider">Mode</span>
        <p class="font-mono font-medium text-gray-800 mt-1">{{ entry.parallelization_mode }}</p>
      </div>
      {% endif %}
      {% if entry.get('max_concurrent_tasks') %}
      <div>
        <span class="text-gray-500 text-xs uppercase tracking-wider">Max concurrent tasks</span>
        <p class="font-bold text-gray-800 mt-1">{{ entry.max_concurrent_tasks }}</p>
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  <!-- ── Raw YAML ─────────────────────────────────────────────────────────── -->
  <section class="rounded-xl border border-gray-200 overflow-hidden">
    <div class="flex items-center justify-between px-5 py-3 border-b border-gray-200 bg-gray-800">
      <h2 class="text-sm font-semibold text-gray-200 tracking-wide uppercase">Registry Entry (YAML)</h2>
      <div class="flex items-center gap-3">
        {% if entry._github_yaml_url %}
        <a href="{{ entry._github_yaml_url }}" target="_blank" rel="noopener"
           class="text-xs text-gray-400 hover:text-indigo-300 underline">View on GitHub →</a>
        {% endif %}
        <button
          class="text-xs bg-gray-700 hover:bg-gray-600 text-gray-200 px-3 py-1.5 rounded-lg font-medium transition-colors"
          onclick="copyYaml()" id="copy-yaml-btn">Copy</button>
      </div>
    </div>
    <div class="bg-gray-950 overflow-x-auto max-h-[32rem] overflow-y-auto">
      <pre class="p-5 text-xs leading-relaxed m-0"><code id="yaml-code" class="language-yaml">{{ entry._raw_yaml }}</code></pre>
    </div>
  </section>

</main>

<!-- ── Footer ────────────────────────────────────────────────────────────── -->
<footer class="border-t border-gray-200 bg-white mt-8 py-6 text-center text-xs text-gray-400">
  <p>
    CUBE Registry — <a href="https://github.com/The-AI-Alliance/cube-registry" class="underline">GitHub</a> ·
    <a href="../" class="underline">All benchmarks</a> ·
    Generated {{ generated_at }}
  </p>
</footer>

<script>
function copyPipInstall() {
  const cmd = document.getElementById('pip-cmd').textContent;
  navigator.clipboard.writeText(cmd).then(() => {
    const btn = document.getElementById('copy-btn');
    btn.textContent = 'Copied!';
    btn.classList.add('bg-green-700');
    setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('bg-green-700'); }, 2000);
  });
}

function copyYaml() {
  const text = document.getElementById('yaml-code').textContent;
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.getElementById('copy-yaml-btn');
    btn.textContent = 'Copied!';
    btn.classList.add('bg-green-700');
    setTimeout(() => {
      btn.textContent = 'Copy';
      btn.classList.remove('bg-green-700');
    }, 2000);
  });
}
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/yaml.min.js"></script>
<script>hljs.highlightElement(document.getElementById('yaml-code'));</script>
</body>
</html>
